/**
 * ActivityStreams builders. Pure: returns ordered structs, no IO.
 */
class {

	variables.AS_CONTEXT = "https://www.w3.org/ns/activitystreams";
	variables.PUBLIC     = "https://www.w3.org/ns/activitystreams##Public";

	/**
	 * Accept of a Follow. The Follow is embedded (not referenced by id) because Lemmy
	 * requires the object to be the Follow itself.
	 */
	struct function accept( required string id, required string actorUrl, required struct follow ) {
		return [
			"@context" : variables.AS_CONTEXT,
			"id"       : id,
			"type"     : "Accept",
			"actor"    : actorUrl,
			"object"   : [
				"id"     : follow.id,
				"type"   : "Follow",
				"actor"  : idOf( follow.actor ),
				"object" : idOf( follow.object )
			]
		];
	}

	/**
	 * Article for author mode. post: { title, summary, content (HTML), url, published (date) }.
	 */
	struct function article( required string id, required string actorUrl, required string followersUrl, required struct post ) {
		return [
			"@context"     : variables.AS_CONTEXT,
			"id"           : id,
			"type"         : "Article",
			"attributedTo" : actorUrl,
			"to"           : [ variables.PUBLIC ],
			"cc"           : [ followersUrl ],
			"name"         : post.title,
			"summary"      : post.summary ?: "",
			"content"      : post.content,
			"mediaType"    : "text/html",
			"url"          : post.url,
			"published"    : isoDate( post.published )
		];
	}

	/**
	 * Create wrapping an embedded object; addressing is copied from the object.
	 */
	struct function create( required string id, required string actorUrl, required struct object ) {
		var embedded = duplicate( object );
		structDelete( embedded, "@context" );
		return [
			"@context"  : variables.AS_CONTEXT,
			"id"        : id,
			"type"      : "Create",
			"actor"     : actorUrl,
			"to"        : embedded.to ?: [],
			"cc"        : embedded.cc ?: [],
			"published" : embedded.published ?: isoDate( now() ),
			"object"    : embedded
		];
	}

	/**
	 * Update wrapping the new version of an object (an Article with `updated` set, or an
	 * actor document). Addressing is copied from the object; an actor has none of its
	 * own, so followersUrl supplies cc.
	 */
	struct function update( required string id, required string actorUrl, required struct object, string followersUrl = "" ) {
		var embedded = duplicate( object );
		structDelete( embedded, "@context" );
		return [
			"@context" : variables.AS_CONTEXT,
			"id"       : id,
			"type"     : "Update",
			"actor"    : actorUrl,
			"to"       : embedded.to ?: [ variables.PUBLIC ],
			"cc"       : embedded.cc ?: ( len( followersUrl ) ? [ followersUrl ] : [] ),
			"object"   : embedded
		];
	}

	/**
	 * Delete of an object, sent as a Tombstone.
	 */
	struct function delete( required string id, required string actorUrl, required string objectId, required string followersUrl ) {
		return [
			"@context" : variables.AS_CONTEXT,
			"id"       : id,
			"type"     : "Delete",
			"actor"    : actorUrl,
			"to"       : [ variables.PUBLIC ],
			"cc"       : [ followersUrl ],
			"object"   : [ "id" : objectId, "type" : "Tombstone" ]
		];
	}

	/**
	 * What a deleted object's id serves (with 410 Gone).
	 */
	struct function tombstone( required string objectId, required string formerType, required date deleted ) {
		return [
			"@context"   : variables.AS_CONTEXT,
			"id"         : objectId,
			"type"       : "Tombstone",
			"formerType" : formerType,
			"deleted"    : isoDate( deleted )
		];
	}

	/**
	 * ISO 8601 in UTC, whole seconds.
	 */
	string function isoDate( required date value ) {
		return value.toInstant().truncatedTo( createObject( "java", "java.time.temporal.ChronoUnit" ).SECONDS ).toString();
	}

	/**
	 * The id of a property that may be either a URL string or an embedded object.
	 */
	string function idOf( any value ) {
		if ( isNull( value ) ) {
			return "";
		}
		if ( isSimpleValue( value ) ) {
			return value;
		}
		if ( isStruct( value ) && value.keyExists( "id" ) && isSimpleValue( value.id ) ) {
			return value.id;
		}
		return "";
	}

}
