/**
 * ActivityStreams builders. Pure: returns ordered structs, no IO.
 */
class {

	variables.AS_CONTEXT = "https://www.w3.org/ns/activitystreams";
	variables.PUBLIC     = "https://www.w3.org/ns/activitystreams##Public";
	// java.util.regex directly: BoxLang's reReplace() rejects the \p{...} Unicode classes.
	variables.NOT_HASHTAG_CHAR = createObject( "java", "java.util.regex.Pattern" ).compile( "[^\p{L}\p{N}_]" );

	/**
	 * Accept of a Follow. The Follow is embedded (not referenced by id) because Lemmy
	 * requires the object to be the Follow itself.
	 */
	struct function accept( required string id, required string actorUrl, required struct follow ) {
		return [
			"@context" : variables.AS_CONTEXT,
			"id"       : id,
			"type"     : "Accept",
			"actor"    : actorUrl,
			"object"   : [
				"id"     : follow.id,
				"type"   : "Follow",
				"actor"  : idOf( follow.actor ),
				"object" : idOf( follow.object )
			]
		];
	}

	/**
	 * Article for author mode. post: { title, summary, content (HTML), url, published (date),
	 * tags (optional array of { name, url }) }.
	 */
	struct function article( required string id, required string actorUrl, required string followersUrl, required struct post ) {
		var doc = [
			"@context"     : variables.AS_CONTEXT,
			"id"           : id,
			"type"         : "Article",
			"attributedTo" : actorUrl,
			"to"           : [ variables.PUBLIC ],
			"cc"           : [ followersUrl ],
			"name"         : post.title,
			"summary"      : post.summary ?: "",
			"content"      : post.content,
			"mediaType"    : "text/html",
			"url"          : post.url,
			"published"    : isoDate( post.published )
		];
		var hashtags = hashtags( post.tags ?: [] );
		if ( hashtags.len() ) {
			doc[ "tag" ] = hashtags;
		}
		return doc;
	}

	/**
	 * Note for a local reply in a fediverse thread. comment: { content (HTML), url, published }.
	 * mentions: [ { actorUrl, handle ("@user@host"), profileUrl } ], each sent as a Mention tag
	 * (what notifies them) and cc'd, and linked at the start of the content the way Mastodon
	 * writes mentions.
	 */
	struct function note(
		required string id,
		required string actorUrl,
		required string followersUrl,
		required string inReplyTo,
		required struct comment,
		array mentions = []
	) {
		var cc    = [ followersUrl ];
		var tags  = [];
		var links = [];
		for ( var mention in mentions ) {
			cc.append( mention.actorUrl );
			tags.append( [ "type" : "Mention", "href" : mention.actorUrl, "name" : mention.handle ] );
			var user = listFirst( mention.handle, "@" );
			links.append( '<span class="h-card" translate="no"><a href="#escapeHtml( len( mention.profileUrl ) ? mention.profileUrl : mention.actorUrl )#" class="u-url mention">@<span>#escapeHtml( user )#</span></a></span>' );
		}
		var content = comment.content;
		if ( links.len() ) {
			var prefix = links.toList( " " ) & " ";
			content = left( content, 3 ) == "<p>" ? "<p>" & prefix & mid( content, 4, len( content ) ) : prefix & content;
		}
		var doc = [
			"@context"     : variables.AS_CONTEXT,
			"id"           : id,
			"type"         : "Note",
			"attributedTo" : actorUrl,
			"inReplyTo"    : inReplyTo,
			"to"           : [ variables.PUBLIC ],
			"cc"           : cc,
			"content"      : content,
			"url"          : comment.url,
			"published"    : isoDate( comment.published )
		];
		if ( tags.len() ) {
			doc[ "tag" ] = tags;
		}
		return doc;
	}

	/**
	 * Hashtag objects for a post's tags ({ name, url }). Names are reduced to letters, digits
	 * and underscores (what Mastodon accepts in a hashtag); empty results and case-insensitive
	 * duplicates are dropped.
	 */
	array function hashtags( required array tags ) {
		var out  = [];
		var seen = {};
		for ( var tag in tags ) {
			var name = variables.NOT_HASHTAG_CHAR.matcher( isStruct( tag ) ? ( tag.name ?: "" ) : tag ).replaceAll( "" );
			if ( !len( name ) || seen.keyExists( lCase( name ) ) ) {
				continue;
			}
			seen[ lCase( name ) ] = true;
			var hashtag = [ "type" : "Hashtag", "name" : "##" & name ];
			if ( isStruct( tag ) && len( tag.url ?: "" ) ) {
				hashtag[ "href" ] = tag.url;
			}
			out.append( hashtag );
		}
		return out;
	}

	/**
	 * Create wrapping an embedded object; addressing is copied from the object.
	 */
	struct function create( required string id, required string actorUrl, required struct object ) {
		var embedded = duplicate( object );
		structDelete( embedded, "@context" );
		return [
			"@context"  : variables.AS_CONTEXT,
			"id"        : id,
			"type"      : "Create",
			"actor"     : actorUrl,
			"to"        : embedded.to ?: [],
			"cc"        : embedded.cc ?: [],
			"published" : embedded.published ?: isoDate( now() ),
			"object"    : embedded
		];
	}

	/**
	 * Update wrapping the new version of an object (an Article with `updated` set, or an
	 * actor document). Addressing is copied from the object; an actor has none of its
	 * own, so followersUrl supplies cc.
	 */
	struct function update( required string id, required string actorUrl, required struct object, string followersUrl = "" ) {
		var embedded = duplicate( object );
		structDelete( embedded, "@context" );
		return [
			"@context" : variables.AS_CONTEXT,
			"id"       : id,
			"type"     : "Update",
			"actor"    : actorUrl,
			"to"       : embedded.to ?: [ variables.PUBLIC ],
			"cc"       : embedded.cc ?: ( len( followersUrl ) ? [ followersUrl ] : [] ),
			"object"   : embedded
		];
	}

	/**
	 * Delete of an object, sent as a Tombstone. extraCc: anyone else the object was addressed to.
	 */
	struct function delete( required string id, required string actorUrl, required string objectId, required string followersUrl, array extraCc = [] ) {
		return [
			"@context" : variables.AS_CONTEXT,
			"id"       : id,
			"type"     : "Delete",
			"actor"    : actorUrl,
			"to"       : [ variables.PUBLIC ],
			"cc"       : [ followersUrl ].append( extraCc, true ),
			"object"   : [ "id" : objectId, "type" : "Tombstone" ]
		];
	}

	/**
	 * What a deleted object's id serves (with 410 Gone).
	 */
	struct function tombstone( required string objectId, required string formerType, required date deleted ) {
		return [
			"@context"   : variables.AS_CONTEXT,
			"id"         : objectId,
			"type"       : "Tombstone",
			"formerType" : formerType,
			"deleted"    : isoDate( deleted )
		];
	}

	/**
	 * Just the characters that matter in text and quoted attributes: encodeForHTML() also
	 * escapes "/" and ":", which bloats every URL.
	 */
	private string function escapeHtml( required string value ) {
		return value.replace( "&", "&amp;", "all" ).replace( "<", "&lt;", "all" ).replace( ">", "&gt;", "all" ).replace( '"', "&quot;", "all" );
	}

	/**
	 * ISO 8601 in UTC, whole seconds.
	 */
	string function isoDate( required date value ) {
		return value.toInstant().truncatedTo( createObject( "java", "java.time.temporal.ChronoUnit" ).SECONDS ).toString();
	}

	/**
	 * The id of a property that may be either a URL string or an embedded object.
	 */
	string function idOf( any value ) {
		if ( isNull( value ) ) {
			return "";
		}
		if ( isSimpleValue( value ) ) {
			return value;
		}
		if ( isStruct( value ) && value.keyExists( "id" ) && isSimpleValue( value.id ) ) {
			return value.id;
		}
		return "";
	}

}
