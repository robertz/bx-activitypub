/**
 * ApActivity persistence. Every activity we send is stored so its id dereferences
 * at /activities/{type}/{uuid}.
 */
class {

	function init( required actors, required string datasource ) {
		variables.actors     = arguments.actors;
		variables.datasource = arguments.datasource;
		return this;
	}

	string function newId() {
		return createObject( "java", "java.util.UUID" ).randomUUID().toString();
	}

	string function urlFor( required string type, required string uuid ) {
		return variables.actors.baseUrl() & "/activities/" & lCase( type ) & "/" & uuid;
	}

	void function store( required string uuid, required struct activity ) {
		queryExecute(
			"INSERT INTO ApActivity (Id, Type, ActorUrl, ObjectUrl, Json) VALUES (UUID_TO_BIN(:id), :type, :actorUrl, :objectUrl, :json)",
			{
				id        : { value : uuid, sqltype : "varchar" },
				type      : { value : activity.type, sqltype : "varchar" },
				actorUrl  : { value : activity.actor, sqltype : "varchar" },
				objectUrl : { value : objectUrlOf( activity ), sqltype : "varchar" },
				json      : { value : jsonSerialize( activity ), sqltype : "longvarchar" }
			},
			{ datasource : variables.datasource }
		);
	}

	/**
	 * The stored JSON string, or "" when there is no activity of that type with that id.
	 */
	string function getJson( required string type, required string uuid ) {
		if ( !isValid( "regex", uuid, "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" ) ) {
			return "";
		}
		var rows = queryExecute(
			"SELECT Type, Json FROM ApActivity WHERE Id = UUID_TO_BIN(:id)",
			{ id : { value : uuid, sqltype : "varchar" } },
			{ datasource : variables.datasource, returntype : "array" }
		);
		if ( !rows.len() || lCase( rows[ 1 ].Type ) != lCase( type ) ) {
			return "";
		}
		return rows[ 1 ].Json;
	}

	/**
	 * uuid of the first stored activity of this type about objectUrl, or "".
	 */
	string function findIdByObject( required string type, required string objectUrl ) {
		var rows = queryExecute(
			"SELECT BIN_TO_UUID(Id) AS Id FROM ApActivity WHERE Type = :type AND ObjectUrl = :objectUrl ORDER BY CreatedAt LIMIT 1",
			{
				type      : { value : type, sqltype : "varchar" },
				objectUrl : { value : objectUrl, sqltype : "varchar" }
			},
			{ datasource : variables.datasource, returntype : "array" }
		);
		return rows.len() ? rows[ 1 ].Id : "";
	}

	/**
	 * The newest stored activity of one of these types about objectUrl, as
	 * { id, type, json, createdAt }, or null.
	 */
	function latestFor( required string objectUrl, required array types ) {
		var rows = queryExecute(
			"SELECT BIN_TO_UUID(Id) AS Id, Type, Json, CreatedAt FROM ApActivity
			 WHERE ObjectUrl = :objectUrl AND Type IN (:types)
			 ORDER BY CreatedAt DESC LIMIT 1",
			{
				objectUrl : { value : objectUrl, sqltype : "varchar" },
				types     : { value : types, sqltype : "varchar", list : true }
			},
			{ datasource : variables.datasource, returntype : "array" }
		);
		if ( !rows.len() ) {
			return javacast( "null", "" );
		}
		return { id : rows[ 1 ].Id, type : rows[ 1 ].Type, json : rows[ 1 ].Json, createdAt : rows[ 1 ].CreatedAt };
	}

	/**
	 * Object URLs under urlPrefix that have been created and not since deleted.
	 */
	array function federatedObjectUrls( required string urlPrefix ) {
		return queryExecute(
			"SELECT ObjectUrl FROM ApActivity
			 WHERE ObjectUrl LIKE :prefix AND Type IN ('Create', 'Delete')
			 GROUP BY ObjectUrl
			 HAVING SUM(Type = 'Create') > 0 AND SUM(Type = 'Delete') = 0
			 ORDER BY ObjectUrl",
			{ prefix : { value : replace( urlPrefix, "%", "\%", "all" ) & "%", sqltype : "varchar" } },
			{ datasource : variables.datasource, returntype : "array" }
		).map( ( row ) => row.ObjectUrl );
	}

	private string function objectUrlOf( required struct activity ) {
		var obj = activity.object ?: "";
		return isSimpleValue( obj ) ? obj : ( obj.id ?: "" );
	}

}
