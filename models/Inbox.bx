/**
 * Inbox: handles Follow and Undo{Follow}; likes and boosts of local posts via Reactions.bx;
 * (when the host accepts them) replies to local posts via Replies.bx; and account deletions
 * of anyone we hold replies or reactions from. Everything else is acknowledged with 202 and
 * dropped without fetching anything. Every handled activity must carry a valid HTTP
 * signature from the activity's own actor.
 *
 * handle() returns { status, reason } for the adapter to send and log.
 */
class {

	function init(
		required signatures,
		required remoteActors,
		required actors,
		required followers,
		required activities,
		required delivery,
		required vocab,
		required replies,
		required reactions
	) {
		variables.signatures   = arguments.signatures;
		variables.remoteActors = arguments.remoteActors;
		variables.actors       = arguments.actors;
		variables.followers    = arguments.followers;
		variables.activities   = arguments.activities;
		variables.delivery     = arguments.delivery;
		variables.vocab        = arguments.vocab;
		variables.replies      = arguments.replies;
		variables.reactions    = arguments.reactions;
		return this;
	}

	/**
	 * headers: lowercase names as received. body: the raw request body (binary or string).
	 */
	struct function handle( required string method, required string path, required struct headers, required any body ) {
		var bodyText = isBinary( body ) ? createObject( "java", "java.lang.String" ).init( body, "UTF-8" ) : body;

		try {
			var activity = jsonDeserialize( bodyText );
		} catch ( any e ) {
			return result( 400, "body is not JSON" );
		}
		if ( !isStruct( activity ) || !isSimpleValue( activity.type ?: "" ) ) {
			return result( 400, "body is not an activity" );
		}
		// Never the body: it can be a followers-only reply or a direct message, which are
		// dropped rather than stored and shouldn't end up in logs either.
		writeLog(
			text = "<-- inbox #method# #path# #activity.type# #variables.vocab.idOf( activity.id ?: '' )# from #variables.vocab.idOf( activity.actor ?: '' )#",
			type = "debug",
			log  = "activitypub"
		);
		var destination = route( activity );
		if ( !len( destination ) ) {
			return result( 202, "ignored #activity.type ?: 'untyped'#" );
		}

		var verified = verify( method, path, headers, body, activity, activity.type == "Delete" );
		if ( !verified.valid ) {
			writeLog( text = "inbox rejected #activity.type# from #variables.vocab.idOf( activity.actor ?: '' )#: #verified.reason# #verified.detail ?: ''#", type = "warning", log = "activitypub" );
			return result( 401, verified.reason );
		}

		switch ( destination ) {
			case "follow":
				return activity.type == "Follow" ? handleFollow( activity, verified.remote ) : handleUndo( activity, verified.remote );
			case "reactions":
				return variables.reactions.handle( activity, verified.remote );
			case "replies":
				return variables.replies.handle( activity, verified.remote );
			case "account":
				var outcome = variables.replies.handle( activity, verified.remote );
				var removed = variables.reactions.removeActor( verified.remote.actorUrl );
				return result( outcome.status, "#outcome.reason#, #removed# reaction(s) removed" );
		}
		return result( 202, "ignored #activity.type#" );
	}

	/**
	 * Where an activity goes, decided without any network access: "follow", "reactions",
	 * "replies", "account" (the sender deleted their account), or "" to ignore it unverified.
	 */
	private string function route( required struct activity ) {
		var type = activity.type ?: "";
		if ( type == "Follow" ) {
			return "follow";
		}
		if ( type == "Undo" ) {
			var inner = activity.object ?: "";
			if ( isStruct( inner ) && ( inner.type ?: "" ) == "Follow" ) {
				return "follow";
			}
			if ( variables.reactions.concerns( activity ) ) {
				return "reactions";
			}
			// Undo by id alone: it may be one of our followers' Follow ids.
			return isSimpleValue( inner ) && len( inner ) ? "follow" : "";
		}
		if ( type == "Delete" ) {
			var objectId = variables.vocab.idOf( activity.object ?: "" );
			if ( len( objectId ) && compare( objectId, variables.vocab.idOf( activity.actor ?: "" ) ) == 0 ) {
				return variables.replies.concerns( activity ) || variables.reactions.hasActor( objectId ) ? "account" : "";
			}
		}
		if ( variables.reactions.concerns( activity ) ) {
			return "reactions";
		}
		if ( variables.replies.concerns( activity ) ) {
			return "replies";
		}
		return "";
	}

	// ---- dispatch ------------------------------------------------------------

	private struct function handleFollow( required struct activity, required struct remote ) {
		if ( !len( variables.vocab.idOf( activity.id ?: "" ) ) ) {
			return result( 400, "Follow has no id" );
		}
		var target = resolveTarget( variables.vocab.idOf( activity.object ?: "" ) );
		if ( isNull( target ) ) {
			return result( 404, "Follow target is not a local actor" );
		}

		variables.followers.add( target.type, target.actor.id, remote, activity.id );

		var actorUrl = variables.actors.actorUrl( target.type, target.actor.name );
		var uuid     = variables.activities.newId();
		var accept   = variables.vocab.accept( variables.activities.urlFor( "Accept", uuid ), actorUrl, activity );
		variables.activities.store( uuid, accept );
		variables.delivery.enqueue( uuid, target.type, target.actor.id, variables.actors.keyId( target.type, target.actor.name ), remote.inboxUrl );

		writeLog( text = "#remote.actorUrl# followed #actorUrl#; Accept #uuid# queued", type = "information", log = "activitypub" );
		return result( 202, "accepted follow" );
	}

	private struct function handleUndo( required struct activity, required struct remote ) {
		var inner = activity.object ?: "";

		if ( isSimpleValue( inner ) ) {
			var removed = len( inner ) ? variables.followers.removeByFollowId( remote.id, inner ) : 0;
			return result( 202, "undo by follow id removed #removed#" );
		}
		if ( !isStruct( inner ) || ( inner.type ?: "" ) != "Follow" ) {
			return result( 202, "ignored Undo of #isStruct( inner ) ? ( inner.type ?: 'untyped' ) : 'non-object'#" );
		}
		if ( variables.vocab.idOf( inner.actor ?: "" ) != remote.actorUrl ) {
			return result( 401, "Undo{Follow} for someone else's Follow" );
		}
		var target = resolveTarget( variables.vocab.idOf( inner.object ?: "" ) );
		if ( isNull( target ) ) {
			return result( 202, "Undo{Follow} of unknown actor" );
		}
		var removed = variables.followers.remove( target.type, target.actor.id, remote.id );
		writeLog( text = "#remote.actorUrl# unfollowed #variables.actors.actorUrl( target.type, target.actor.name )# (removed #removed#)", type = "information", log = "activitypub" );
		return result( 202, "removed #removed#" );
	}

	// ---- verification --------------------------------------------------------

	/**
	 * { valid, reason, remote }. The Host header is taken from our configured base URL
	 * rather than the request, so a tunnel or proxy that rewrites Host can't break
	 * verification; a request signed for any other host still fails.
	 */
	private struct function verify( required string method, required string path, required struct headers, required any body, required struct activity, boolean allowStaleKey = false ) {
		if ( !len( headers.signature ?: "" ) ) {
			return { valid : false, reason : "no Signature header" };
		}
		try {
			var parsed = variables.signatures.parseSignatureHeader( headers.signature );
		} catch ( any e ) {
			return { valid : false, reason : e.message };
		}

		var signed  = duplicate( headers );
		signed.host = variables.actors.authority();

		try {
			var remote = variables.remoteActors.forKeyId( parsed.keyId, false, allowStaleKey );
		} catch ( BxActivityPub.KeyMismatch e ) {
			try {
				remote = variables.remoteActors.forKeyId( parsed.keyId, true );
			} catch ( any e2 ) {
				return { valid : false, reason : "key lookup failed: #e2.message#" };
			}
		} catch ( any e ) {
			return { valid : false, reason : "key lookup failed: #e.message#" };
		}

		var check = variables.signatures.verifyRequest( method, path, signed, body, parsed, remote.publicKeyPem );
		if ( !check.valid && remote.fromCache ) {
			// The remote may have rotated its key since we cached it.
			try {
				remote = variables.remoteActors.forKeyId( parsed.keyId, true );
				check  = variables.signatures.verifyRequest( method, path, signed, body, parsed, remote.publicKeyPem );
			} catch ( any e ) {
				return { valid : false, reason : "key refresh failed: #e.message#" };
			}
		}
		if ( !check.valid ) {
			return { valid : false, reason : check.reason, detail : check.detail ?: "" };
		}

		var claimedActor = variables.vocab.idOf( activity.actor ?: "" );
		if ( compare( claimedActor, remote.actorUrl ) != 0 ) {
			return { valid : false, reason : "activity actor #claimedActor# is not the key owner #remote.actorUrl#" };
		}
		return { valid : true, reason : "", remote : remote };
	}

	// ---- helpers -------------------------------------------------------------

	/**
	 * { type, actor } for a local Person/Group URL the host knows, or null.
	 */
	private function resolveTarget( required string targetUrl ) {
		var localRef = variables.actors.parseLocalUrl( targetUrl );
		if ( isNull( localRef ) ) {
			return javacast( "null", "" );
		}
		var actor = variables.actors.findActor( localRef.type, localRef.name );
		if ( isNull( actor ) ) {
			return javacast( "null", "" );
		}
		return { type : localRef.type, actor : actor };
	}

	private struct function result( required numeric status, required string reason ) {
		return { status : status, reason : reason };
	}

}
