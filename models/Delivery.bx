/**
 * DB-backed delivery queue (ApDelivery). Safe to run on several app instances at once:
 * each run claims due rows with a single UPDATE ... LIMIT tagged with its own token, and a
 * claim expires after CLAIM_LEASE_MINUTES so rows held by a crashed worker come back.
 *
 * A slow or dead inbox can't hold up the others: a run sends to up to MAX_PARALLEL_INBOXES
 * inboxes at once, and within one inbox stops at the first failure, deferring the rest of
 * that inbox's rows instead of waiting out a timeout for each. 410 Gone removes the
 * followers behind the inbox and finishes all of its rows.
 *
 * Each inbox gets its activities in the order they were created (a post's Create before its
 * Update before its Delete): rows are sent oldest first, and rows behind a failure are
 * deferred to the failed row's retry time so they can't overtake it.
 */
class {

	// Minutes to wait after each failed attempt; once exhausted the delivery is abandoned.
	variables.BACKOFF_MINUTES      = [ 1, 5, 30, 120, 720 ];
	variables.CLAIM_LEASE_MINUTES  = 5;
	variables.DEFER_MINUTES        = 1;
	variables.MAX_PARALLEL_INBOXES = 10;

	function init( required httpClient, required actors, required followers, required string datasource ) {
		variables.http       = arguments.httpClient;
		variables.actors     = arguments.actors;
		variables.followers  = arguments.followers;
		variables.datasource = arguments.datasource;
		return this;
	}

	void function enqueue(
		required string activityId,
		required string signingType,
		required string signingLocalId,
		required string signingKeyId,
		required string inboxUrl
	) {
		queryExecute(
			"INSERT INTO ApDelivery (ActivityId, SigningActorType, SigningLocalId, SigningKeyId, InboxUrl, NextAttemptAt)
			 VALUES (UUID_TO_BIN(:activityId), :signingType, UUID_TO_BIN(:signingLocalId), :signingKeyId, :inboxUrl, NOW(3))",
			{
				activityId     : { value : activityId, sqltype : "varchar" },
				signingType    : { value : signingType, sqltype : "varchar" },
				signingLocalId : { value : signingLocalId, sqltype : "varchar" },
				signingKeyId   : { value : signingKeyId, sqltype : "varchar" },
				inboxUrl       : { value : inboxUrl, sqltype : "varchar" }
			},
			{ datasource : variables.datasource }
		);
	}

	/**
	 * Claims and sends up to batchSize due deliveries. Returns the number attempted.
	 */
	numeric function runOnce( numeric batchSize = 20 ) {
		var token = createObject( "java", "java.util.UUID" ).randomUUID().toString();
		queryExecute(
			"UPDATE ApDelivery
			 SET ClaimToken = UUID_TO_BIN(:token), NextAttemptAt = NOW(3) + INTERVAL #variables.CLAIM_LEASE_MINUTES# MINUTE
			 WHERE NextAttemptAt <= NOW(3)
			 ORDER BY NextAttemptAt
			 LIMIT #int( batchSize )#",
			{ token : { value : token, sqltype : "varchar" } },
			{ datasource : variables.datasource }
		);
		var rows = queryExecute(
			"SELECT BIN_TO_UUID(D.Id) AS Id, D.SigningActorType, BIN_TO_UUID(D.SigningLocalId) AS SigningLocalId,
				D.SigningKeyId, D.InboxUrl, D.Attempts, A.Json
			 FROM ApDelivery D
			 JOIN ApActivity A ON A.Id = D.ActivityId
			 WHERE D.ClaimToken = UUID_TO_BIN(:token)
			 ORDER BY A.CreatedAt, D.Id",
			{ token : { value : token, sqltype : "varchar" } },
			{ datasource : variables.datasource, returntype : "array" }
		);
		arrayEach(
			array      = groupByInbox( rows ),
			callback   = ( group ) => deliverGroup( group ),
			parallel   = true,
			maxThreads = variables.MAX_PARALLEL_INBOXES
		);
		return rows.len();
	}

	// ---- private -------------------------------------------------------------

	/**
	 * Rows grouped by exact inbox URL, oldest first within each group.
	 */
	private array function groupByInbox( required array rows ) {
		var byInbox = createObject( "java", "java.util.LinkedHashMap" ).init();
		for ( var row in rows ) {
			var group = byInbox.get( row.InboxUrl );
			if ( isNull( group ) ) {
				group = [];
			}
			group.append( row );
			byInbox.put( row.InboxUrl, group );
		}
		var groups = [];
		for ( var group in byInbox.values() ) {
			groups.append( group );
		}
		return groups;
	}

	/**
	 * Sends one inbox's rows in order, stopping at the first one that doesn't succeed.
	 */
	private void function deliverGroup( required array group ) {
		for ( var i = 1; i <= group.len(); i++ ) {
			var result = deliver( group[ i ] );
			if ( result.outcome == "delivered" ) {
				continue;
			}
			var rest = i < group.len() ? group.slice( i + 1 ) : [];
			if ( result.outcome == "gone" ) {
				rest.each( ( row ) => markGone( row.Id, row.Attempts ) );
			} else {
				var waitMinutes = result.retryMinutes;
				rest.each( ( row ) => deferRow( row.Id, waitMinutes ) );
			}
			return;
		}
	}

	/**
	 * Returns { outcome ("delivered", "gone" for 410, or "failed"), retryMinutes (when the
	 * failed row will be tried again; DEFER_MINUTES once it has been given up on) }.
	 */
	private struct function deliver( required struct row ) {
		var status = javacast( "null", "" );
		var error  = "";
		try {
			var keys     = variables.actors.getKeys( row.SigningActorType, row.SigningLocalId );
			var response = variables.http.signedPost( row.InboxUrl, row.Json, row.SigningKeyId, keys.privateKeyPem );
			status       = response.status;
			if ( status >= 200 && status <= 299 ) {
				markDelivered( row.Id, status );
				return { outcome : "delivered", retryMinutes : 0 };
			}
			if ( status == 410 ) {
				var removed = variables.followers.removeByInbox( row.InboxUrl );
				writeLog( text = "#row.InboxUrl# is gone (410); removed #removed# follower(s)", type = "information", log = "activitypub" );
				markGone( row.Id, row.Attempts );
				return { outcome : "gone", retryMinutes : 0 };
			}
			error = left( response.body, 1000 );
		} catch ( any e ) {
			error = left( e.type & ": " & e.message, 1000 );
		}
		var statusText = isNull( status ) ? "no response" : status;
		writeLog( text = "delivery #row.Id# to #row.InboxUrl# failed (attempt #row.Attempts + 1#): #statusText# #error#", type = "warning", log = "activitypub" );
		var attempts = row.Attempts + 1;
		markFailed( row.Id, attempts, isNull( status ) ? 0 : status, error );
		return {
			outcome      : "failed",
			retryMinutes : attempts <= variables.BACKOFF_MINUTES.len() ? variables.BACKOFF_MINUTES[ attempts ] : variables.DEFER_MINUTES
		};
	}

	private void function markGone( required string id, required numeric attempts ) {
		queryExecute(
			"UPDATE ApDelivery SET Attempts = :attempts, LastStatus = 410, LastError = 'Gone: followers behind this inbox removed',
				NextAttemptAt = NULL, ClaimToken = NULL
			 WHERE Id = UUID_TO_BIN(:id)",
			{
				id       : { value : id, sqltype : "varchar" },
				attempts : { value : attempts + 1, sqltype : "integer" }
			},
			{ datasource : variables.datasource }
		);
	}

	/**
	 * Releases a row that wasn't attempted because an earlier row for the same inbox failed
	 * in this run. Its attempt count is untouched: it never reached the inbox.
	 */
	private void function deferRow( required string id, required numeric minutes ) {
		queryExecute(
			"UPDATE ApDelivery SET ClaimToken = NULL, NextAttemptAt = NOW(3) + INTERVAL #int( minutes )# MINUTE,
				LastError = 'deferred: an earlier delivery to this inbox failed in the same run'
			 WHERE Id = UUID_TO_BIN(:id)",
			{ id : { value : id, sqltype : "varchar" } },
			{ datasource : variables.datasource }
		);
	}

	private void function markDelivered( required string id, required numeric status ) {
		queryExecute(
			"UPDATE ApDelivery SET DeliveredAt = NOW(3), NextAttemptAt = NULL, ClaimToken = NULL, LastStatus = :status,
				Attempts = Attempts + 1, LastError = NULL
			 WHERE Id = UUID_TO_BIN(:id)",
			{
				id     : { value : id, sqltype : "varchar" },
				status : { value : status, sqltype : "integer" }
			},
			{ datasource : variables.datasource }
		);
	}

	// status 0 = no HTTP response (timeout, refused, unsafe URL)
	private void function markFailed( required string id, required numeric attempts, required numeric status, required string error ) {
		var nextSql = attempts <= variables.BACKOFF_MINUTES.len()
			? "NOW(3) + INTERVAL #variables.BACKOFF_MINUTES[ attempts ]# MINUTE"
			: "NULL";
		queryExecute(
			"UPDATE ApDelivery SET Attempts = :attempts, LastStatus = :status, LastError = :error, ClaimToken = NULL,
				NextAttemptAt = #nextSql#
			 WHERE Id = UUID_TO_BIN(:id)",
			{
				id       : { value : id, sqltype : "varchar" },
				attempts : { value : attempts, sqltype : "integer" },
				status   : { value : status, sqltype : "integer", null : status == 0 },
				error    : { value : error, sqltype : "varchar" }
			},
			{ datasource : variables.datasource }
		);
	}

}
