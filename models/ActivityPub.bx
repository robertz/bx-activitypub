/**
 * Facade the host app and adapters talk to. Wires the models together.
 *
 *   ap = new bxactivitypub.models.ActivityPub( host = myHost, settings = { datasource : "mydsn" } );
 *
 * host implements contracts/IHostApp.bx, and optionally contracts/IRemoteReplies.bx to accept
 * replies from the fediverse. isPublic() gates every actor and object lookup,
 * so a non-public actor or post is never served, followed or delivered.
 *
 * settings:
 *   datasource        (required) where the Ap* tables live
 *   maxAgeSeconds     oldest incoming signed Date accepted (default 3600)
 *   maxFutureSeconds  furthest-ahead incoming signed Date accepted (default 300)
 *   httpTimeoutSeconds outbound connect + request timeout (default 10)
 *   userAgent         outbound User-Agent (default "bx-activitypub/{version} (+{baseUrl})")
 *   softwareName      NodeInfo software.name, ^[a-z0-9-]+$ (default "bx-activitypub")
 *   softwareVersion   NodeInfo software.version (default this module's version)
 *   threadMaxDepth       levels below a delivered reply that fetchThreads() follows (default 3)
 *   threadMaxPostAgeDays posts older than this aren't walked (default 30)
 *   threadMaxNewPerRun   new replies fetched per fetchThreads() run (default 50)
 *   threadWalkMinutes    how often each reply's replies are re-read (default 30)
 */
class {

	variables.VERSION = "0.6.1";

	function init( required host, required struct settings ) {
		if ( !len( settings.datasource ?: "" ) ) {
			throw( type = "BxActivityPub.ConfigurationException", message = "settings.datasource is required" );
		}
		var dsn = settings.datasource;

		variables.host = host;
		variables.signatures = new Signatures( settings.maxAgeSeconds ?: 3600, settings.maxFutureSeconds ?: 300 );
		variables.vocab      = new Vocab();
		variables.actors     = new Actors( host, variables.signatures, dsn );
		variables.http       = new HttpClient(
			signatures     = variables.signatures,
			timeoutSeconds = settings.httpTimeoutSeconds ?: 10,
			userAgent      = settings.userAgent ?: "bx-activitypub/#variables.VERSION# (+#variables.actors.baseUrl()#)"
		);
		variables.remoteActors = new RemoteActors( variables.http, variables.actors, dsn );
		variables.followers    = new Followers( dsn );
		variables.activities   = new Activities( variables.actors, dsn );
		variables.delivery     = new Delivery( variables.http, variables.actors, variables.followers, dsn );
		variables.webFinger    = new WebFinger( variables.actors );
		variables.nodeInfo     = new NodeInfo(
			actors          = variables.actors,
			activities      = variables.activities,
			datasource      = dsn,
			softwareName    = settings.softwareName ?: "bx-activitypub",
			softwareVersion = settings.softwareVersion ?: variables.VERSION
		);
		variables.remoteObjects = new RemoteObjects( dsn );
		variables.replies       = new Replies(
			host          = host,
			actors        = variables.actors,
			remoteObjects = variables.remoteObjects,
			remoteActors  = variables.remoteActors,
			followers     = variables.followers,
			vocab         = variables.vocab
		);
		variables.threads       = new Threads(
			host             = host,
			replies          = variables.replies,
			remoteObjects    = variables.remoteObjects,
			httpClient       = variables.http,
			actors           = variables.actors,
			vocab            = variables.vocab,
			maxDepth         = settings.threadMaxDepth ?: 3,
			maxPostAgeDays   = settings.threadMaxPostAgeDays ?: 30,
			maxNewPerRun     = settings.threadMaxNewPerRun ?: 50,
			walkEveryMinutes = settings.threadWalkMinutes ?: 30
		);
		variables.reactions     = new Reactions( host = host, actors = variables.actors, vocab = variables.vocab, datasource = dsn );
		variables.inbox        = new Inbox(
			signatures   = variables.signatures,
			remoteActors = variables.remoteActors,
			actors       = variables.actors,
			followers    = variables.followers,
			activities   = variables.activities,
			delivery     = variables.delivery,
			vocab        = variables.vocab,
			replies      = variables.replies,
			reactions    = variables.reactions
		);
		return this;
	}

	/**
	 * Author mode: sends Create{Article} for a post to its author's followers.
	 * Returns { activityId, queued, alreadyPublished }. Publishing a post that already has a
	 * Create is a no-op; changes to it go out through syncPost().
	 */
	struct function publishPost( required string postId ) {
		if ( isNull( variables.host.getObject( "post", postId ) ) ) {
			throw( type = "BxActivityPub.NotFound", message = "Host has no post [#postId#]" );
		}
		var post = publicPost( postId );
		if ( isNull( post ) ) {
			throw( type = "BxActivityPub.NotPublic", message = "Post [#postId#] is not public" );
		}
		var author = variables.actors.findActor( "Person", post.author );
		if ( isNull( author ) ) {
			throw( type = "BxActivityPub.NotFound", message = "Host has no Person [#post.author#] for post [#postId#]" );
		}

		var article  = buildArticle( postId, post, author );
		var existing = variables.activities.findIdByObject( "Create", article.id );
		if ( len( existing ) ) {
			return { activityId : existing, queued : 0, alreadyPublished : true };
		}

		var uuid = variables.activities.newId();
		variables.activities.store( uuid, variables.vocab.create( variables.activities.urlFor( "Create", uuid ), article.attributedTo, article ) );
		var queued = sendToFollowers( uuid, "Person", author );
		writeLog( text = "published #article.id# as Create #uuid# to #queued# inbox(es)", type = "information", log = "activitypub" );
		return { activityId : uuid, queued : queued, alreadyPublished : false };
	}

	/**
	 * Brings followers' copy of a post in line with the host, whatever changed:
	 *   public, never sent                         -> Create
	 *   public, sent, title/summary/content/url/tags changed -> Update
	 *   sent, now not public or gone from the host -> Delete (Tombstone)
	 * Returns { action ("create" | "update" | "delete" | "none"), activityId, queued }.
	 * Safe to call repeatedly: an unchanged post sends nothing. A deleted post's id stays
	 * deleted even if the post becomes public again (Mastodon refuses to recreate an id).
	 */
	struct function syncPost( required string postId ) {
		var objectUrl = variables.actors.objectUrl( "post", postId );
		var last      = variables.activities.latestFor( objectUrl, [ "Create", "Update", "Delete" ] );
		var post      = publicPost( postId );
		var author    = isNull( post ) ? javacast( "null", "" ) : variables.actors.findActor( "Person", post.author );

		if ( isNull( author ) ) {
			return isNull( last ) || last.type == "Delete" ? noAction() : deleteObject( "post", postId, last );
		}
		if ( isNull( last ) ) {
			var created = publishPost( postId );
			return { action : "create", activityId : created.activityId, queued : created.queued };
		}
		if ( last.type == "Delete" ) {
			return noAction();
		}

		var article = buildArticle( postId, post, author );
		if ( !articleChanged( article, jsonDeserialize( last.json ).object ) ) {
			return noAction();
		}
		article[ "updated" ] = variables.vocab.isoDate( now() );
		var uuid = variables.activities.newId();
		variables.activities.store( uuid, variables.vocab.update( variables.activities.urlFor( "Update", uuid ), article.attributedTo, article ) );
		var queued = sendToFollowers( uuid, "Person", author );
		writeLog( text = "updated #objectUrl# as Update #uuid# to #queued# inbox(es)", type = "information", log = "activitypub" );
		return { action : "update", activityId : uuid, queued : queued };
	}

	/**
	 * Post ids (kind "post") that have been created on the fediverse and not deleted, so a
	 * host sweep can revisit posts that have since gone private or been removed.
	 */
	array function federatedPostIds() {
		var prefix = variables.actors.objectUrl( "post", "" );
		return variables.activities.federatedObjectUrls( prefix ).map( ( objectUrl ) => mid( objectUrl, len( prefix ) + 1, len( objectUrl ) ) );
	}

	/**
	 * Replying back: brings the fediverse's copy of a local reply (kind "comment") in line with
	 * the host, like syncPost(). A comment goes out as a Note from its author's account when
	 * the host says it's public and it answers a remote reply the host accepted, or a local
	 * reply that went out itself; the remote author being answered is mentioned (and so
	 * notified) and gets it in their own inbox as well as the followers. Top-level comments and
	 * replies in threads with no one from the fediverse never go out.
	 * Returns { action ("create" | "update" | "delete" | "none"), activityId, queued }.
	 */
	struct function syncComment( required string commentId ) {
		var objectUrl = variables.actors.objectUrl( "comment", commentId );
		var last      = variables.activities.latestFor( objectUrl, [ "Create", "Update", "Delete" ] );
		var note      = commentNote( commentId );

		if ( isNull( note ) ) {
			return isNull( last ) || last.type == "Delete" ? noAction() : deleteObject( "comment", commentId, last );
		}
		if ( !isNull( last ) && last.type == "Delete" ) {
			return noAction();
		}
		var author = variables.actors.findActor( "Person", variables.actors.parseLocalUrl( note.attributedTo ).name );
		var type   = "Create";
		if ( !isNull( last ) ) {
			if ( compare( note.content, jsonDeserialize( last.json ).object.content ?: "" ) == 0 ) {
				return noAction();
			}
			note[ "updated" ] = variables.vocab.isoDate( now() );
			type = "Update";
		}
		var uuid     = variables.activities.newId();
		var activity = type == "Create"
			? variables.vocab.create( variables.activities.urlFor( type, uuid ), note.attributedTo, note )
			: variables.vocab.update( variables.activities.urlFor( type, uuid ), note.attributedTo, note );
		variables.activities.store( uuid, activity );
		var queued = sendToFollowers( uuid, "Person", author, mentionedActors( note ) );
		writeLog( text = "#type == 'Create' ? 'published' : 'updated'# #objectUrl# as #type# #uuid# to #queued# inbox(es)", type = "information", log = "activitypub" );
		return { action : lCase( type ), activityId : uuid, queued : queued };
	}

	/**
	 * Comment ids that have gone out and not been deleted, for a host sweep (see federatedPostIds()).
	 */
	array function federatedCommentIds() {
		var prefix = variables.actors.objectUrl( "comment", "" );
		return variables.activities.federatedObjectUrls( prefix ).map( ( objectUrl ) => mid( objectUrl, len( prefix ) + 1, len( objectUrl ) ) );
	}

	/**
	 * Sends Update{actor} when the actor's public profile (name, bio, avatar, header, url) differs
	 * from the last one sent; the first call always sends. Returns { action, activityId, queued }.
	 */
	struct function syncActor( required string type, required string name ) {
		var actor = variables.actors.findActor( type, name );
		if ( isNull( actor ) ) {
			return noAction();
		}
		var doc  = variables.actors.document( type, name );
		var last = variables.activities.latestFor( doc.id, [ "Update" ] );
		if ( !isNull( last ) && !profileChanged( doc, jsonDeserialize( last.json ).object ) ) {
			return noAction();
		}
		var uuid = variables.activities.newId();
		variables.activities.store( uuid, variables.vocab.update( variables.activities.urlFor( "Update", uuid ), doc.id, doc, doc.followers ) );
		var queued = sendToFollowers( uuid, type, actor );
		writeLog( text = "profile of #doc.id# sent as Update #uuid# to #queued# inbox(es)", type = "information", log = "activitypub" );
		return { action : "update", activityId : uuid, queued : queued };
	}

	/**
	 * Likes and boosts of a local object (kind "post"): { likes, boosts }.
	 */
	struct function reactionCounts( required string kind, required string id ) {
		return variables.reactions.counts( variables.actors.objectUrl( kind, id ) );
	}

	/**
	 * The ActivityPub document for a local object (kind "post"), or null. A post that was
	 * deleted from the fediverse serves a Tombstone (the adapter answers 410 Gone).
	 */
	function objectDocument( required string kind, required string id ) {
		if ( kind == "comment" ) {
			return commentDocument( id );
		}
		if ( kind != "post" ) {
			return javacast( "null", "" );
		}
		var objectUrl = variables.actors.objectUrl( "post", id );
		var post      = publicPost( id );
		var author    = isNull( post ) ? javacast( "null", "" ) : variables.actors.findActor( "Person", post.author );
		if ( isNull( author ) ) {
			var deleted = variables.activities.latestFor( objectUrl, [ "Delete" ] );
			return isNull( deleted ) ? javacast( "null", "" ) : variables.vocab.tombstone( objectUrl, "Article", deleted.createdAt );
		}
		var article     = buildArticle( id, post, author );
		var lastUpdate  = variables.activities.latestFor( objectUrl, [ "Update" ] );
		if ( !isNull( lastUpdate ) ) {
			article[ "updated" ] = jsonDeserialize( lastUpdate.json ).object.updated;
		}
		return article;
	}

	/**
	 * The object's human-facing URL, or "" (for redirecting browsers from the id path).
	 */
	string function objectHtmlUrl( required string kind, required string id ) {
		if ( kind == "comment" ) {
			var note = commentNote( id );
			return isNull( note ) ? "" : note.url;
		}
		if ( kind != "post" ) {
			return "";
		}
		var post = publicPost( id );
		return isNull( post ) ? "" : ( post.url ?: "" );
	}

	/**
	 * The actor's HTML profile page, or "" (for redirecting browsers from the actor id).
	 */
	string function actorHtmlUrl( required string type, required string name ) {
		var actor = variables.actors.findActor( type, name );
		return isNull( actor ) ? "" : ( actor.url ?: "" );
	}

	struct function nodeInfoLinks() {
		return variables.nodeInfo.wellKnown();
	}

	struct function nodeInfoDocument() {
		return variables.nodeInfo.document();
	}

	function webfinger( required string resource ) {
		return variables.webFinger.resolve( resource );
	}

	function actorDocument( required string type, required string name ) {
		return variables.actors.document( type, name );
	}

	struct function instanceActorDocument() {
		return variables.actors.instanceDocument();
	}

	struct function handleInbox( required string method, required string path, required struct headers, required any body ) {
		return variables.inbox.handle( method, path, headers, body );
	}

	numeric function processDeliveries( numeric batchSize = 20 ) {
		return variables.delivery.runOnce( batchSize );
	}

	/**
	 * Whole threads: fetches replies further down fediverse threads that weren't delivered
	 * (see Threads.bx). Does nothing for a host without IRemoteReplies.
	 * Returns { walked, fetched, accepted, removed }.
	 */
	struct function fetchThreads() {
		return variables.threads.run();
	}

	/**
	 * Stored activity JSON, or "" if unknown.
	 */
	string function activityJson( required string type, required string uuid ) {
		return variables.activities.getJson( type, uuid );
	}

	/**
	 * Followers are reported as a count only; the list itself is never published.
	 */
	function followersCollection( required string type, required string name ) {
		var actor = variables.actors.findActor( type, name );
		if ( isNull( actor ) ) {
			return javacast( "null", "" );
		}
		return [
			"@context"   : "https://www.w3.org/ns/activitystreams",
			"id"         : variables.actors.actorUrl( type, actor.name ) & "/followers",
			"type"       : "OrderedCollection",
			"totalItems" : variables.followers.count( type, actor.id )
		];
	}

	/**
	 * Delete{Tombstone} for a post or comment that was sent before, to everyone the last
	 * version went to. Signed by the actor that created it, looked up without the isPublic
	 * gate: retracting is exactly what a now-hidden actor or object needs.
	 */
	private struct function deleteObject( required string kind, required string id, required struct last ) {
		var sent    = jsonDeserialize( last.json );
		var creator = sent.actor;
		var localRef = variables.actors.parseLocalUrl( creator );
		var actor    = isNull( localRef ) ? javacast( "null", "" ) : variables.host.findActor( localRef.type, localRef.name );
		if ( isNull( actor ) ) {
			writeLog( text = "cannot delete #kind# #id#: its actor #creator# no longer exists", type = "warning", log = "activitypub" );
			return noAction();
		}
		var actorUrl  = variables.actors.actorUrl( localRef.type, actor.name );
		var objectUrl = variables.actors.objectUrl( kind, id );
		var mentioned = mentionedActors( sent.object );
		var uuid      = variables.activities.newId();
		variables.activities.store( uuid, variables.vocab.delete( variables.activities.urlFor( "Delete", uuid ), actorUrl, objectUrl, actorUrl & "/followers", mentioned ) );
		var queued = sendToFollowers( uuid, localRef.type, actor, mentioned );
		writeLog( text = "deleted #objectUrl# as Delete #uuid# to #queued# inbox(es)", type = "information", log = "activitypub" );
		return { action : "delete", activityId : uuid, queued : queued };
	}

	/**
	 * Queues activity uuid to every follower inbox of the actor, plus the inboxes of
	 * alsoTo (remote actor URLs, e.g. someone mentioned), shared inboxes deduplicated, signed
	 * with the actor's key. Returns the number queued.
	 */
	private numeric function sendToFollowers( required string uuid, required string type, required struct actor, array alsoTo = [] ) {
		var inboxes = variables.followers.deliveryInboxes( type, actor.id );
		for ( var remoteUrl in alsoTo ) {
			try {
				var remote = variables.remoteActors.lookup( remoteUrl );
				var inbox  = len( remote.sharedInboxUrl ) ? remote.sharedInboxUrl : remote.inboxUrl;
				if ( !inboxes.find( inbox ) ) {
					inboxes.append( inbox );
				}
			} catch ( any e ) {
				writeLog( text = "not sending #uuid# to #remoteUrl#: #e.message#", type = "warning", log = "activitypub" );
			}
		}
		var keyId   = variables.actors.keyId( type, actor.name );
		for ( var inbox in inboxes ) {
			variables.delivery.enqueue( uuid, type, actor.id, keyId, inbox );
		}
		return inboxes.len();
	}

	// compare(), not ==: BoxLang's string == ignores case, and a case-only edit is still an edit.
	private boolean function articleChanged( required struct current, required struct sent ) {
		for ( var field in [ "name", "summary", "content", "url" ] ) {
			if ( compare( current[ field ] ?: "", sent[ field ] ?: "" ) != 0 ) {
				return true;
			}
		}
		return compare( hashtagNames( current ), hashtagNames( sent ) ) != 0;
	}

	private string function hashtagNames( required struct article ) {
		var names = [];
		for ( var tag in isArray( article.tag ?: "" ) ? article.tag : [] ) {
			if ( isStruct( tag ) && ( tag.type ?: "" ) == "Hashtag" ) {
				names.append( tag.name ?: "" );
			}
		}
		return names.toList( " " );
	}

	private boolean function profileChanged( required struct current, required struct sent ) {
		for ( var field in [ "preferredUsername", "name", "summary", "url" ] ) {
			if ( compare( current[ field ] ?: "", sent[ field ] ?: "" ) != 0 ) {
				return true;
			}
		}
		for ( var imageField in [ "icon", "image" ] ) {
			var currentUrl = isStruct( current[ imageField ] ?: "" ) ? current[ imageField ].url : "";
			var sentUrl    = isStruct( sent[ imageField ] ?: "" ) ? sent[ imageField ].url : "";
			if ( compare( currentUrl, sentUrl ) != 0 ) {
				return true;
			}
		}
		return false;
	}

	private struct function noAction() {
		return { action : "none", activityId : "", queued : 0 };
	}

	/**
	 * The Note a local comment goes out as, or null when it must not go out: the host doesn't
	 * have it or says it isn't public, its post or author isn't public, or it doesn't answer
	 * something on the fediverse (a remote reply, or a local reply that went out and wasn't
	 * deleted). Answering a local reply carries that reply's mentions forward.
	 */
	private function commentNote( required string commentId ) {
		var comment = variables.host.getObject( "comment", commentId );
		if ( isNull( comment ) || !variables.host.isPublic( "comment", commentId ) || !len( comment.parentId ?: "" ) ) {
			return javacast( "null", "" );
		}
		var author = variables.actors.findActor( "Person", comment.author );
		if ( isNull( author ) || isNull( publicPost( comment.postId ) ) ) {
			return javacast( "null", "" );
		}

		var mentions = [];
		var inReplyTo = "";
		var remote    = variables.remoteObjects.findByHostId( comment.parentId );
		if ( !isNull( remote ) ) {
			inReplyTo = remote.objectUrl;
			mentions  = [ remote.actorUrl ];
		} else {
			inReplyTo = variables.actors.objectUrl( "comment", comment.parentId );
			var parent = variables.activities.latestFor( inReplyTo, [ "Create", "Update", "Delete" ] );
			if ( isNull( parent ) || parent.type == "Delete" ) {
				return javacast( "null", "" );
			}
			mentions = mentionedActors( jsonDeserialize( parent.json ).object );
		}

		var mentionDetails = [];
		for ( var actorUrl in mentions ) {
			try {
				var remoteActor = variables.remoteActors.lookup( actorUrl );
				mentionDetails.append( { actorUrl : actorUrl, handle : remoteActor.handle, profileUrl : remoteActor.profileUrl } );
			} catch ( any e ) {
				writeLog( text = "comment #commentId#: cannot mention #actorUrl#: #e.message#", type = "warning", log = "activitypub" );
			}
		}
		var actorUrl = variables.actors.actorUrl( "Person", author.name );
		return variables.vocab.note(
			id           = variables.actors.objectUrl( "comment", commentId ),
			actorUrl     = actorUrl,
			followersUrl = actorUrl & "/followers",
			inReplyTo    = inReplyTo,
			comment      = comment,
			mentions     = mentionDetails
		);
	}

	private function commentDocument( required string commentId ) {
		var objectUrl = variables.actors.objectUrl( "comment", commentId );
		var last      = variables.activities.latestFor( objectUrl, [ "Create", "Update", "Delete" ] );
		if ( isNull( last ) ) {
			return javacast( "null", "" );
		}
		if ( last.type == "Delete" ) {
			return variables.vocab.tombstone( objectUrl, "Note", last.createdAt );
		}
		var note = commentNote( commentId );
		if ( isNull( note ) ) {
			return javacast( "null", "" );
		}
		if ( last.type == "Update" ) {
			note[ "updated" ] = jsonDeserialize( last.json ).object.updated;
		}
		return note;
	}

	/**
	 * Actor URLs of an object's Mention tags.
	 */
	private array function mentionedActors( required struct object ) {
		var out = [];
		for ( var tag in isArray( object.tag ?: "" ) ? object.tag : [] ) {
			if ( isStruct( tag ) && ( tag.type ?: "" ) == "Mention" && len( tag.href ?: "" ) ) {
				out.append( tag.href );
			}
		}
		return out;
	}

	/**
	 * The host's post, or null when it doesn't exist or isn't public.
	 */
	private function publicPost( required string id ) {
		var post = variables.host.getObject( "post", id );
		if ( isNull( post ) || !variables.host.isPublic( "post", id ) ) {
			return javacast( "null", "" );
		}
		return post;
	}

	private struct function buildArticle( required string postId, required struct post, required struct author ) {
		var actorUrl = variables.actors.actorUrl( "Person", author.name );
		return variables.vocab.article( variables.actors.objectUrl( "post", postId ), actorUrl, actorUrl & "/followers", post );
	}

	function outboxCollection( required string type, required string name ) {
		var actor = variables.actors.findActor( type, name );
		if ( isNull( actor ) ) {
			return javacast( "null", "" );
		}
		return [
			"@context"     : "https://www.w3.org/ns/activitystreams",
			"id"           : variables.actors.actorUrl( type, actor.name ) & "/outbox",
			"type"         : "OrderedCollection",
			"totalItems"   : 0,
			"orderedItems" : []
		];
	}

}
