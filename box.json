{
    "name": "BxActivityPub",
    "version": "0.7.0",
    "author": "Robert Zehnder",
    "slug": "bx-activitypub",
    "shortDescription": "ActivityPub federation for BoxLang apps: publish posts to Mastodon and the fediverse, and accept public replies back. WebFinger, HTTP Signatures, a durable delivery queue.",
    "type": "boxlang-modules",
    "keywords": [
        "boxlang",
        "activitypub",
        "fediverse",
        "mastodon",
        "federation",
        "webfinger"
    ],
    "homepage": "https://github.com/robertz/bx-activitypub",
    "repository": {
        "type": "git",
        "URL": "https://github.com/robertz/bx-activitypub"
    },
    "bugs": "https://github.com/robertz/bx-activitypub/issues",
    "boxlang": {
        "minimumVersion": "1.17.0",
        "moduleName": "bxactivitypub"
    },
    "private": false,
    "license": [
        {
            "type": "MIT",
            "URL": "https://opensource.org/licenses/MIT"
        }
    ],
    "devDependencies": {
        "testbox": "^7.0.0",
        "bx-mysql": "*"
    },
    "installPaths": {
        "testbox": "testbox/",
        "bx-mysql": "boxlang_modules/bx-mysql/"
    },
    "scripts": {
        "test": "!boxlang --bx-config ./tests/boxlang.json run-tests.bxs"
    },
    "ignore": [
        "**/.*",
        "tests/**",
        "testbox/**",
        "examples/**",
        "docs/**",
        "boxlang_modules/**",
        "run-tests.bxs"
    ]
}
