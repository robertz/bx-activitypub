class implements="contracts.IHostApp" {

	variables.ACTORS = {
		"Group"  : { "general" : { id : "0192a6f0-0000-7000-8000-000000000001", name : "general", displayName : "General", summary : "" } },
		"Person" : {
			"robert" : { id : "0192a6f0-0000-7000-8000-000000000002", name : "robert", displayName : "Robert", summary : "", url : "https://site.example/about" },
			"hidden" : { id : "0192a6f0-0000-7000-8000-000000000004", name : "hidden", displayName : "Hidden", summary : "" }
		}
	};

	variables.POSTS = {
		"0192a6f0-0000-7000-8000-000000000101" : {
			author    : "robert",
			title     : "Hello",
			summary   : "First post",
			content   : "<p>Body</p>",
			url       : "https://site.example/posts/2026/09/hello",
			published : createDateTime( 2026, 9, 28, 12, 0, 0 )
		},
		"0192a6f0-0000-7000-8000-000000000103" : {
			author    : "robert",
			title     : "Draft",
			summary   : "Not yet",
			content   : "<p>Secret</p>",
			url       : "https://site.example/posts/2026/09/draft",
			published : createDateTime( 2026, 9, 28, 12, 0, 0 )
		},
		"0192a6f0-0000-7000-8000-000000000102" : {
			author    : "ghost",
			title     : "Orphan",
			summary   : "",
			content   : "<p>No such author</p>",
			url       : "https://site.example/posts/2026/09/orphan",
			published : createDateTime( 2026, 9, 28, 12, 0, 0 )
		}
	};

	function getObject( required string type, required string id ) {
		return type == "post" ? ( variables.POSTS[ id ] ?: javacast( "null", "" ) ) : javacast( "null", "" );
	}

	// The draft post and the inactive Person "hidden" are not public.
	variables.PRIVATE_IDS = [ "0192a6f0-0000-7000-8000-000000000103", "0192a6f0-0000-7000-8000-000000000004" ];

	boolean function isPublic( required string type, required string id ) {
		return !variables.PRIVATE_IDS.contains( id );
	}

	// ---- test controls: specs mutate the host to simulate edits, unpublishing and deletion

	void function putPost( required string id, required struct post ) {
		variables.POSTS[ id ] = post;
	}

	void function removePost( required string id ) {
		structDelete( variables.POSTS, id );
	}

	void function setPublic( required string id, required boolean visible ) {
		arrayDelete( variables.PRIVATE_IDS, id );
		if ( !visible ) {
			variables.PRIVATE_IDS.append( id );
		}
	}

	void function setActorField( required string type, required string name, required string field, required any value ) {
		variables.ACTORS[ type ][ name ][ field ] = value;
	}

	string function baseUrl() {
		return "https://site.example";
	}

	function findActor( required string type, required string name ) {
		return variables.ACTORS[ type ][ name ] ?: javacast( "null", "" );
	}

}
