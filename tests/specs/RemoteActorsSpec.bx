class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "RemoteActors.parseActor", () => {

			beforeEach( () => {
				variables.remoteActors = new models.RemoteActors( createEmptyMock( "models.HttpClient" ), createEmptyMock( "models.Actors" ), "unused" );
				variables.doc = {
					id        : "https://mastodon.social/ap/users/1",
					type      : "Person",
					inbox     : "https://mastodon.social/ap/users/1/inbox",
					endpoints : { sharedInbox : "https://mastodon.social/inbox" },
					publicKey : { id : "https://mastodon.social/ap/users/1##main-key", owner : "https://mastodon.social/ap/users/1", publicKeyPem : "PEM" },
					preferredUsername : "zendarr",
					name      : "Robert Zehnder",
					url       : "https://mastodon.social/@zendarr",
					icon      : { type : "Image", mediaType : "image/png", url : "https://files.mastodon.social/a.png" }
				};
			} );

			it( "extracts inboxes and key from a Mastodon-shaped actor", () => {
				var parsed = remoteActors.parseActor( doc.id, doc );
				expect( parsed ).toBe( {
					actorUrl       : doc.id,
					inboxUrl       : doc.inbox,
					sharedInboxUrl : "https://mastodon.social/inbox",
					publicKeyId    : doc.publicKey.id,
					publicKeyPem   : "PEM",
					name           : "Robert Zehnder",
					handle         : "@zendarr@mastodon.social",
					profileUrl     : "https://mastodon.social/@zendarr",
					avatarUrl      : "https://files.mastodon.social/a.png"
				} );
			} );

			it( "falls back to the username for a missing display name", () => {
				doc.name = "";
				expect( remoteActors.parseActor( doc.id, doc ).name ).toBe( "zendarr" );
			} );

			it( "reads url and icon given as arrays or Link objects, and only keeps https", () => {
				doc.url  = [ { type : "Link", href : "https://mastodon.social/@zendarr" } ];
				doc.icon = [ { type : "Image", url : "http://insecure.example/a.png" } ];
				var parsed = remoteActors.parseActor( doc.id, doc );
				expect( parsed.profileUrl ).toBe( "https://mastodon.social/@zendarr" );
				expect( parsed.avatarUrl ).toBe( "" );
			} );

			it( "tolerates a missing sharedInbox", () => {
				structDelete( doc, "endpoints" );
				expect( remoteActors.parseActor( doc.id, doc ).sharedInboxUrl ).toBe( "" );
			} );

			it( "rejects an actor id on a different host than requested", () => {
				expect( () => remoteActors.parseActor( "https://evil.example/u/1", doc ) ).toThrow( "BxActivityPub.InvalidActor" );
			} );

			it( "rejects an inbox on another host", () => {
				doc.inbox = "https://victim.example/admin";
				expect( () => remoteActors.parseActor( doc.id, doc ) ).toThrow( "BxActivityPub.InvalidActor" );
			} );

			it( "rejects a sharedInbox on another host", () => {
				doc.endpoints.sharedInbox = "https://victim.example/inbox";
				expect( () => remoteActors.parseActor( doc.id, doc ) ).toThrow( "BxActivityPub.InvalidActor" );
			} );

			it( "rejects a key owned by someone else", () => {
				doc.publicKey.owner = "https://mastodon.social/ap/users/2";
				expect( () => remoteActors.parseActor( doc.id, doc ) ).toThrow( "BxActivityPub.InvalidActor" );
			} );

			it( "rejects an actor without a key", () => {
				structDelete( doc, "publicKey" );
				expect( () => remoteActors.parseActor( doc.id, doc ) ).toThrow( "BxActivityPub.InvalidActor" );
			} );

		} );

		describe( "RemoteActors.fetchAndStore", () => {

			it( "fails fast for an actor that failed recently, without fetching again", () => {
				var http   = createEmptyMock( "models.HttpClient" ).$( "signedGet", { status : 404, body : "", contentType : "" } );
				var actors = createEmptyMock( "models.Actors" ).$( "instanceSigner", { keyId : "k", privateKeyPem : "p" } );
				var remote = new models.RemoteActors( http, actors, "unused" );
				expect( () => remote.fetchAndStore( "https://junk.example/users/1" ) ).toThrow( regex = "returned 404" );
				expect( () => remote.fetchAndStore( "https://junk.example/users/1" ) ).toThrow( regex = "failed recently" );
				expect( () => remote.forKeyId( "https://junk.example/users/1##main-key", true ) ).toThrow( regex = "failed recently" );
				expect( http.$count( "signedGet" ) ).toBe( 1 );
			} );

			it( "tries again once the failure has aged out", () => {
				var http   = createEmptyMock( "models.HttpClient" ).$( "signedGet", { status : 404, body : "", contentType : "" } );
				var actors = createEmptyMock( "models.Actors" ).$( "instanceSigner", { keyId : "k", privateKeyPem : "p" } );
				var remote = new models.RemoteActors( httpClient = http, actors = actors, datasource = "unused", failureTtlSeconds = 0 );
				expect( () => remote.fetchAndStore( "https://junk.example/users/1" ) ).toThrow( regex = "returned 404" );
				expect( () => remote.fetchAndStore( "https://junk.example/users/1" ) ).toThrow( regex = "returned 404" );
				expect( http.$count( "signedGet" ) ).toBe( 2 );
			} );

		} );
	}

}
