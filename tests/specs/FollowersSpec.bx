class extends="testbox.system.BaseSpec" {

	variables.GROUP_ID = "0192a6f0-0000-7000-8000-000000000001";

	function beforeAll() {
		variables.db = new tests.helpers.TestDb();
		db.reset();
		db.rows( "INSERT INTO ApRemoteActor (Id, ActorUrl, InboxUrl, SharedInboxUrl, PublicKeyId, PublicKeyPem)
			VALUES (UUID_TO_BIN('11111111-1111-1111-1111-111111111111'), 'https://r.example/u/a', 'https://r.example/u/a/inbox', 'https://r.example/inbox', 'k', 'p')" );
		variables.remote = { id : "11111111-1111-1111-1111-111111111111", inboxUrl : "https://r.example/u/a/inbox", sharedInboxUrl : "https://r.example/inbox" };
	}

	function run() {
		describe( "Followers", () => {

			beforeEach( () => {
				db.rows( "DELETE FROM ApFollower" );
				variables.followers = new models.Followers( db.dsn() );
			} );

			it( "adds, counts and removes a follower", () => {
				followers.add( "Group", GROUP_ID, remote, "https://r.example/f/1" );
				expect( followers.count( "Group", GROUP_ID ) ).toBe( 1 );
				expect( followers.remove( "Group", GROUP_ID, remote.id ) ).toBe( 1 );
				expect( followers.count( "Group", GROUP_ID ) ).toBe( 0 );
			} );

			it( "treats a repeated Follow as one follower with the newest Follow id", () => {
				followers.add( "Group", GROUP_ID, remote, "https://r.example/f/1" );
				followers.add( "Group", GROUP_ID, remote, "https://r.example/f/2" );
				expect( followers.count( "Group", GROUP_ID ) ).toBe( 1 );
				expect( followers.removeByFollowId( remote.id, "https://r.example/f/1" ) ).toBe( 0 );
				expect( followers.removeByFollowId( remote.id, "https://r.example/f/2" ) ).toBe( 1 );
			} );

			it( "only removes by Follow id for the same remote actor", () => {
				followers.add( "Group", GROUP_ID, remote, "https://r.example/f/1" );
				expect( followers.removeByFollowId( "22222222-2222-2222-2222-222222222222", "https://r.example/f/1" ) ).toBe( 0 );
				expect( followers.count( "Group", GROUP_ID ) ).toBe( 1 );
			} );

		} );
	}

}
