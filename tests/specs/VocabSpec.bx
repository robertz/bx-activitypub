class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "Vocab", () => {

			beforeEach( () => {
				variables.vocab = new models.Vocab();
			} );

			it( "builds an Accept embedding the Follow, keys in a stable order", () => {
				var follow = { id : "https://r.example/f/1", type : "Follow", actor : { id : "https://r.example/u/a", type : "Person" }, object : "https://s.example/c/general", extra : "dropped" };
				var accept = vocab.accept( "https://s.example/activities/accept/1", "https://s.example/c/general", follow );
				expect( jsonSerialize( accept ) ).toBe(
					'{"@context":"https://www.w3.org/ns/activitystreams","id":"https://s.example/activities/accept/1","type":"Accept","actor":"https://s.example/c/general",'
					& '"object":{"id":"https://r.example/f/1","type":"Follow","actor":"https://r.example/u/a","object":"https://s.example/c/general"}}'
				);
			} );

			it( "builds an Article addressed to Public with followers in cc", () => {
				var article = vocab.article( "https://s.example/post/1", "https://s.example/u/robert", "https://s.example/u/robert/followers", {
					title : "Hello", summary : "Sum", content : "<p>Hi</p>", url : "https://s.example/posts/2026/09/hello",
					published : parseDateTime( "2026-09-28T12:00:00Z" )
				} );
				expect( article.type ).toBe( "Article" );
				expect( article.attributedTo ).toBe( "https://s.example/u/robert" );
				expect( article.to ).toBe( [ "https://www.w3.org/ns/activitystreams##Public" ] );
				expect( article.cc ).toBe( [ "https://s.example/u/robert/followers" ] );
				expect( article.name ).toBe( "Hello" );
				expect( article.mediaType ).toBe( "text/html" );
				expect( article.url ).toBe( "https://s.example/posts/2026/09/hello" );
				expect( article.published ).toBe( "2026-09-28T12:00:00Z" );
			} );

			it( "wraps an object in a Create that copies its addressing and drops the inner @context", () => {
				var article = vocab.article( "https://s.example/post/1", "https://s.example/u/robert", "https://s.example/u/robert/followers", {
					title : "Hello", content : "<p>Hi</p>", url : "https://s.example/p", published : parseDateTime( "2026-09-28T12:00:00Z" )
				} );
				var create = vocab.create( "https://s.example/activities/create/1", "https://s.example/u/robert", article );
				expect( create.type ).toBe( "Create" );
				expect( create.actor ).toBe( "https://s.example/u/robert" );
				expect( create.to ).toBe( article.to );
				expect( create.cc ).toBe( article.cc );
				expect( create.published ).toBe( article.published );
				expect( create.object.id ).toBe( "https://s.example/post/1" );
				expect( create.object.keyExists( "@context" ) ).toBeFalse();
				expect( article.keyExists( "@context" ) ).toBeTrue();
			} );

			it( "builds an Update carrying the object's addressing, or followers for an actor", () => {
				var article = { id : "https://s.example/post/1", type : "Article", to : [ "p" ], cc : [ "f" ], "@context" : "x" };
				var update  = vocab.update( "https://s.example/activities/update/1", "https://s.example/u/robert", article );
				expect( update.type ).toBe( "Update" );
				expect( update.to ).toBe( [ "p" ] );
				expect( update.cc ).toBe( [ "f" ] );
				expect( update.object.keyExists( "@context" ) ).toBeFalse();

				var person = vocab.update( "https://s.example/activities/update/2", "https://s.example/u/robert", { id : "https://s.example/u/robert", type : "Person" }, "https://s.example/u/robert/followers" );
				expect( person.to ).toBe( [ "https://www.w3.org/ns/activitystreams##Public" ] );
				expect( person.cc ).toBe( [ "https://s.example/u/robert/followers" ] );
			} );

			it( "builds a Delete of a Tombstone and a served Tombstone", () => {
				var del = vocab.delete( "https://s.example/activities/delete/1", "https://s.example/u/robert", "https://s.example/post/1", "https://s.example/u/robert/followers" );
				expect( del.type ).toBe( "Delete" );
				expect( del.object ).toBe( { id : "https://s.example/post/1", type : "Tombstone" } );
				var tomb = vocab.tombstone( "https://s.example/post/1", "Article", parseDateTime( "2026-09-28T12:00:00Z" ) );
				expect( tomb.type ).toBe( "Tombstone" );
				expect( tomb.formerType ).toBe( "Article" );
				expect( tomb.deleted ).toBe( "2026-09-28T12:00:00Z" );
			} );

			it( "formats dates as whole-second UTC", () => {
				expect( vocab.isoDate( parseDateTime( "2026-09-28T12:00:00.789Z" ) ) ).toBe( "2026-09-28T12:00:00Z" );
			} );

			it( "reads ids from strings, embedded objects, and nothing", () => {
				expect( vocab.idOf( "https://x" ) ).toBe( "https://x" );
				expect( vocab.idOf( { id : "https://y" } ) ).toBe( "https://y" );
				expect( vocab.idOf( { type : "Note" } ) ).toBe( "" );
				expect( vocab.idOf( [ "a" ] ) ).toBe( "" );
				expect( vocab.idOf( javacast( "null", "" ) ) ).toBe( "" );
			} );

		} );
	}

}
