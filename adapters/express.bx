/**
 * Mounts the ActivityPub routes on a BoxExpress app and schedules the delivery worker.
 * Mount it before the app's own page routes: actor/object GETs only answer requests that
 * ask for ActivityPub JSON and call next() for everything else, so the HTML page still wins
 * for browsers.
 *
 *   new bxactivitypub.adapters.express().mount( app, ap );
 */
class {

	variables.AP_CONTENT_TYPE = "application/activity+json; charset=utf-8";
	variables.TYPES           = { "u" : "Person", "c" : "Group" };

	/**
	 * Uses the module's settings (see ModuleConfig.bx: maxInboxBytes, inboxRateLimit,
	 * deliveryIntervalMs, threadIntervalMs); options override them for this mount.
	 * inboxRateLimit keys on req.ip, so behind a proxy set the app's "trust proxy" (or
	 * "trust proxy header") first. Servers retry a 429.
	 */
	function mount( required app, required ap, struct options = {} ) {
		var config = ap.getSettings().append( options, true );
		variables.ap            = ap;
		variables.maxInboxBytes = config.maxInboxBytes;

		app.get( "/.well-known/webfinger", ( req, res ) => webfingerRoute( req, res ) );
		app.get( "/.well-known/nodeinfo", ( req, res ) => sendNodeInfo( res, variables.ap.nodeInfoLinks(), "application/json" ) );
		app.get( "/nodeinfo/2.1", ( req, res ) => sendNodeInfo( res, variables.ap.nodeInfoDocument(), 'application/json; profile="http://nodeinfo.diaspora.software/ns/schema/2.1##"' ) );
		app.get( "/actor", ( req, res ) => sendActivityJson( res, variables.ap.instanceActorDocument() ) );
		var limitInbox = config.inboxRateLimit > 0
			? boxExpressRateLimit( { windowMs : 60000, max : config.inboxRateLimit } )
			: ( req, res, next ) => next();
		app.post( "/inbox", limitInbox, ( req, res ) => inboxRoute( req, res ) );

		for ( var prefix in variables.TYPES ) {
			app.get( "/#prefix#/:name", ( req, res, next ) => actorRoute( req, res, next ) );
			app.post( "/#prefix#/:name/inbox", limitInbox, ( req, res ) => inboxRoute( req, res ) );
			app.get( "/#prefix#/:name/outbox", ( req, res ) => collectionRoute( req, res, "outbox" ) );
			app.get( "/#prefix#/:name/followers", ( req, res ) => collectionRoute( req, res, "followers" ) );
		}

		app.get( "/post/:id", ( req, res, next ) => objectRoute( req, res, next, "post" ) );
		app.get( "/comment/:id", ( req, res, next ) => objectRoute( req, res, next, "comment" ) );
		app.get( "/activities/:type/:uuid", ( req, res, next ) => activityRoute( req, res, next ) );

		if ( config.deliveryIntervalMs > 0 ) {
			app.schedule( config.deliveryIntervalMs, () => variables.ap.processDeliveries(), { name : "activitypub-delivery" } );
		}
		if ( config.threadIntervalMs > 0 ) {
			app.schedule( config.threadIntervalMs, () => variables.ap.fetchThreads(), { name : "activitypub-threads" } );
		}
		return this;
	}

	// ---- routes --------------------------------------------------------------

	private function webfingerRoute( req, res ) {
		res.set( "Access-Control-Allow-Origin", "*" );
		var resource = req.query.resource ?: "";
		if ( !len( resource ) ) {
			return res.status( 400 ).type( "text/plain" ).send( "resource is required" );
		}
		var jrd = variables.ap.webfinger( resource );
		if ( isNull( jrd ) ) {
			return res.status( 404 ).type( "text/plain" ).send( "not found" );
		}
		return res.type( "application/jrd+json; charset=utf-8" ).send( jsonSerialize( jrd ) );
	}

	private function actorRoute( req, res, next ) {
		if ( !wantsActivityJson( req ) ) {
			var htmlUrl = variables.ap.actorHtmlUrl( typeFromPath( req.path ), req.params.name );
			return len( htmlUrl ) ? res.redirect( htmlUrl, 302 ) : next();
		}
		var doc = variables.ap.actorDocument( typeFromPath( req.path ), req.params.name );
		if ( isNull( doc ) ) {
			return res.status( 404 ).type( "text/plain" ).send( "not found" );
		}
		return sendActivityJson( res, doc );
	}

	private function collectionRoute( req, res, required string kind ) {
		var type = typeFromPath( req.path );
		var doc  = kind == "followers"
			? variables.ap.followersCollection( type, req.params.name )
			: variables.ap.outboxCollection( type, req.params.name );
		if ( isNull( doc ) ) {
			return res.status( 404 ).type( "text/plain" ).send( "not found" );
		}
		return sendActivityJson( res, doc );
	}

	/**
	 * ActivityPub clients get the object; browsers are redirected to its HTML page.
	 */
	private function objectRoute( req, res, next, required string kind ) {
		if ( !wantsActivityJson( req ) ) {
			var htmlUrl = variables.ap.objectHtmlUrl( kind, req.params.id );
			return len( htmlUrl ) ? res.redirect( htmlUrl, 302 ) : next();
		}
		var doc = variables.ap.objectDocument( kind, req.params.id );
		if ( isNull( doc ) ) {
			return res.status( 404 ).type( "text/plain" ).send( "not found" );
		}
		if ( doc.type == "Tombstone" ) {
			res.status( 410 );
		}
		return sendActivityJson( res, doc );
	}

	private function activityRoute( req, res, next ) {
		var json = variables.ap.activityJson( req.params.type, req.params.uuid );
		if ( !len( json ) ) {
			return res.status( 404 ).type( "text/plain" ).send( "not found" );
		}
		return res.type( variables.AP_CONTENT_TYPE ).send( json );
	}

	private function inboxRoute( req, res ) {
		var stream = req.bodyStream();
		var body   = stream.readNBytes( variables.maxInboxBytes + 1 );
		if ( arrayLen( body ) > variables.maxInboxBytes ) {
			return res.status( 413 ).type( "text/plain" ).send( "body too large" );
		}
		var headers = {};
		for ( var name in req.headers ) {
			headers[ lCase( name ) ] = req.headers[ name ];
		}
		var outcome = variables.ap.handleInbox( req.method, req.originalUrl, headers, body );
		writeLog( text = "inbox #req.originalUrl# -> #outcome.status# #outcome.reason#", type = "debug", log = "activitypub" );
		return res.status( outcome.status ).type( "text/plain" ).send( outcome.reason );
	}

	// ---- helpers -------------------------------------------------------------

	private function sendActivityJson( res, required struct doc ) {
		return res.type( variables.AP_CONTENT_TYPE ).send( jsonSerialize( doc ) );
	}

	private function sendNodeInfo( res, required struct doc, required string contentType ) {
		res.set( "Access-Control-Allow-Origin", "*" );
		return res.type( contentType ).send( jsonSerialize( doc ) );
	}

	private boolean function wantsActivityJson( req ) {
		var accept = lCase( req.get( "Accept" ) ?: "" );
		return accept.find( "application/activity+json" )
			|| ( accept.find( "application/ld+json" ) && accept.find( "https://www.w3.org/ns/activitystreams" ) );
	}

	private string function typeFromPath( required string path ) {
		return variables.TYPES[ listFirst( path, "/" ) ];
	}

}
