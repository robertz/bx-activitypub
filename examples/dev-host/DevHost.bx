/**
 * Milestone 1-2 stand-in for the real host app: hardcoded actors and one post.
 */
class {

	variables.ACTORS = {
		"Group" : {
			"general" : {
				id          : "0192a6f0-0000-7000-8000-000000000001",
				name        : "general",
				displayName : "General",
				summary     : "<p>bx-activitypub test group</p>"
			}
		},
		"Person" : {
			"robert" : {
				id          : "0192a6f0-0000-7000-8000-000000000002",
				name        : "robert",
				displayName : "Robert Zehnder",
				summary     : "<p>bx-activitypub test author</p>"
			}
		}
	};

	variables.POST_ID = "0192a6f0-0000-7000-8000-000000000101";

	function init( required string baseUrl ) {
		variables.base  = arguments.baseUrl;
		variables.POSTS = {
			"#variables.POST_ID#" : {
				author    : "robert",
				title     : "Hello, fediverse",
				summary   : "The first post federated by bx-activitypub.",
				content   : "<p>This post was published from a BoxLang app by <strong>bx-activitypub</strong>.</p><p>If you can read this on Mastodon, author-mode federation works.</p>",
				url       : variables.base & "/posts/2026/09/hello-fediverse",
				slug      : "hello-fediverse",
				published : createDateTime( 2026, 9, 28, 12, 0, 0 )
			}
		};
		return this;
	}

	string function baseUrl() {
		return variables.base;
	}

	function findActor( required string type, required string name ) {
		return variables.ACTORS[ type ][ name ] ?: javacast( "null", "" );
	}

	function getObject( required string type, required string id ) {
		return type == "post" ? ( variables.POSTS[ id ] ?: javacast( "null", "" ) ) : javacast( "null", "" );
	}

	string function postId() {
		return variables.POST_ID;
	}

	function findPostBySlug( required string slug ) {
		for ( var id in variables.POSTS ) {
			if ( variables.POSTS[ id ].slug == slug ) {
				return variables.POSTS[ id ];
			}
		}
		return javacast( "null", "" );
	}

}
